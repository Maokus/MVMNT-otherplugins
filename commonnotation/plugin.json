      "entry": "src/layout-study.ts",
      "capabilities": {
        "required": [],
        "optional": []
      }
    },
    {
      "type": "commonnotation-orbit",
      "entry": "src/notation-orbit.ts",
      "capabilities": {
        "required": ["timeline.read"],
        "optional": []
      }
    },
    {
      "type": "commonnotation-schematic-structure",
      "entry": "src/schematic-structure.ts",
